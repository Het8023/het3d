{
    "name": "het3d",
    "version": "0.2.2",
    "description": "A Vue 3 and Babylon.js based 3D scene editor/viewer component.",
    "type": "module",
    "main": "./dist/het3d.umd.cjs",
    "module": "./dist/het3d.es.js",
    "types": "./src/het3d/index.d.ts",
    "style": "./dist/het3d.css",
    "files": [
        "dist",
        "src/het3d/index.d.ts"
    ],
    "sideEffects": [
        "*.css",
        "**/*.css"
    ],
    "exports": {
        ".": {
            "types": "./src/het3d/index.d.ts",
            "import": "./dist/het3d.es.js",
            "require": "./dist/het3d.umd.cjs"
        },
        "./style.css": "./dist/het3d.css"
    },
    "keywords": [
        "het3d",
        "babylonjs",
        "vue3",
        "3d",
        "editor"
    ],
    "license": "MIT",
    "scripts": {
        "build": "vite build --config vite.lib.config.js",
        "build:lib": "vite build --config vite.lib.config.js",
        "pack:check": "npm pack --dry-run"
    },
    "peerDependencies": {
        "vue": "^3.5.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.2.4",
        "vite": "^6.3.5",
        "vue": "^3.5.17"
    },
    "dependencies": {
        "@babylonjs/core": "^9.16.1",
        "@babylonjs/loaders": "^9.16.1"
    }
}
